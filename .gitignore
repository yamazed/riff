# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
.pytest_cache/
.venv/
venv/

# Build output — riff.exe is published as a release asset, not committed
build/
dist/
*.spec
*.exe

# Video renders and their intermediates. These are large binaries; they belong
# on a release or a video host, not in git history.
tutorial/video-build/
tutorial/*.mp4
tutorial/voice-samples/
docs/*.webm
*.poster.jpg

# The walkthrough page and its narration ARE committed, so GitHub Pages can
# serve them; rebuild with tutorial/build.py. The standalone variant is not.
tutorial/riff-walkthrough-standalone.html

# Local state
.riff/
ui-url.txt
*.jsonl

# Editors / OS
.vscode/
.idea/
Thumbs.db
desktop.ini
.DS_Store
